# 发射服务环境配置

# 服务端口
PORT=3001

# Solana RPC
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# SOLANA_RPC_URL=https://api.devnet.solana.com

# BSC RPC
BSC_RPC_URL=https://bsc-dataseed.binance.org
# BSC_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# ==================== 安全配置 ====================

# API 密钥（用于 HMAC 签名验证，必须与 Go 后端配置一致）
API_SECRET=wagmi-launch-service-secret-2026

# 允许的请求来源 IP（逗号分隔，* 表示允许所有）
# 生产环境应该只允许 Go 后端 IP
ALLOWED_IPS=127.0.0.1,::1,localhost

# ==================== 交易限额（可选，默认不限制）====================

# 单次最大买入金额（默认不限制）
# MAX_BUY_AMOUNT_SOL=999999
# MAX_BUY_AMOUNT_BNB=999999

# 每日最大交易次数（默认不限制）
# MAX_DAILY_TX_COUNT=999999

# ==================== Jito 配置 ====================

# Jito 配置（可选，用于加速交易）
# JITO_URL=ny.mainnet.block-engine.jito.wtf

# 优先费配置 (lamports)
PRIORITY_FEE_UNIT_LIMIT=250000
PRIORITY_FEE_UNIT_PRICE=250000

# 滑点 (basis points, 100 = 1%)
SLIPPAGE_BPS=100
